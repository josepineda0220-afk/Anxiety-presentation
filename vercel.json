{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "echo 'Retired: every path redirects to Firebase Hosting'",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/:path(.*)",
      "destination": "https://anxiety-brain-deck.web.app/:path",
      "statusCode": 301
    }
  ]
}
