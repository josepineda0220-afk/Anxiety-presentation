# Copy to .env and fill in. Every VITE_ value ends up in the browser, so none of these is a secret:
# who may change the deck is decided by firestore.rules, not by anything here.

# Firebase web app config (Firebase console -> Project settings -> Your apps -> Web app).
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=anxiety-brain-deck.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=anxiety-brain-deck
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# The shared editor account. Unlocking Input mode signs in as this account with the team password,
# and firestore.rules only let its UID write. Leave it out and the deck is view-only.
VITE_EDITOR_EMAIL=editors@anxiety-presentation.invalid

# App Check (reCAPTCHA Enterprise). The site key is public by design.
VITE_APPCHECK_SITE_KEY=your-recaptcha-enterprise-site-key

# Local development only (`npm run dev`, never production builds): an App Check debug token you
# registered in the Firebase console. Left empty, the console prints a new token to register.
# Keep it in .env.development.local rather than .env.
# VITE_APPCHECK_DEBUG_TOKEN=

# Optional: the deck's document id in the `presentations` collection.
VITE_PRESENTATION_ID=anxiety-deck
