# Supabase project credentials (from Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Team password required to unlock Input Mode & save encrypted changes to Supabase
# (Defaults to "nursing2026" if omitted)
VITE_EDIT_PASSWORD=nursing2026

# Shared AES-256-GCM encryption passphrase used by Web Crypto API before sending data to Supabase
VITE_DECK_ENCRYPTION_KEY=anxiety-presentation-e2ee-key-v1

# Optional: custom presentation row ID in `public.presentations`
VITE_PRESENTATION_ID=anxiety-deck
