# Firebase web app config (Firebase console -> Project settings -> Your apps -> Web app).
# These identify the project; they are not secrets. Firestore rules decide who may write.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# Shared AES-256-GCM encryption passphrase used by the Web Crypto API before data is sent to Firestore
VITE_DECK_ENCRYPTION_KEY=anxiety-presentation-e2ee-key-v1

# Optional: custom document ID in the Firestore `presentations` collection
VITE_PRESENTATION_ID=anxiety-deck

# Only used when the Firebase settings above are missing (offline / local-only mode).
# With Firebase, the team password is the password of the editor account in Firebase Auth.
VITE_EDIT_PASSWORD=nursing2026
