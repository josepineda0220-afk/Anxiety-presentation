# Used by `npm run dev:emulators`: the app talks to the local emulators started by `npm run emulators`.
# These are demo values, not secrets, and they override anything in .env.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=demo-anxiety-deck
VITE_FIREBASE_APP_ID=1:0:web:0
VITE_EDITOR_EMAIL=editors@anxiety-presentation.invalid
VITE_APPCHECK_SITE_KEY=
VITE_PRESENTATION_ID=anxiety-deck
